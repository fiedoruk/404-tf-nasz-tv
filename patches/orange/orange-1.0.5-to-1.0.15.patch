+++ b/plugin.video.orange_go/resources/lib/tata_metadata.py
@@ -0,0 +1,75 @@
+"""Small, credential-free channel metadata cache; never performs network I/O."""
+
+import json
+import os
+import tempfile
+
+MAX_CACHE_BYTES = 512 * 1024
+
+
+def _text(value, limit=256):
+    return value.strip()[:limit] if isinstance(value, str) else ''
+
+
+def save_channels(path, channels):
+    """Write only public channel fields; failure must not affect channel listing."""
+    temporary = None
+    try:
+        entries = {}
+        for channel in channels:
+            cid = channel.get('channelExtId')
+            if not isinstance(cid, (str, int)) or isinstance(cid, bool):
+                continue
+            cid = str(cid).strip()[:128]
+            if not cid:
+                continue
+            entries[cid] = {
+                'name': _text(channel.get('name')),
+                'logo_signature': _text(channel.get('logoSignature'), 1024),
+                'category': _text(channel.get('category')),
+            }
+        payload = json.dumps({'schema': 1, 'channels': entries}, ensure_ascii=False)
+        if len(payload.encode('utf-8')) > MAX_CACHE_BYTES:
+            return False
+        fd, temporary = tempfile.mkstemp(prefix='channel-metadata-', suffix='.tmp',
+                                         dir=os.path.dirname(path))
+        with os.fdopen(fd, 'w', encoding='utf-8') as handle:
+            handle.write(payload)
+        os.replace(temporary, path)
+        return True
+    except (OSError, TypeError, ValueError, AttributeError):
+        return False
+    finally:
+        if temporary and os.path.exists(temporary):
+            try:
+                os.unlink(temporary)
+            except OSError:
+                pass
+
+
+def get_channel(path, cid, logo_base, fallback_icon, live=True):
+    """Resolve a label without fetching channels or EPG on the playback path."""
+    cid = str(cid).strip()[:128] if cid is not None else ''
+    entry = {}
+    try:
+        with open(path, encoding='utf-8') as handle:
+            raw = handle.read(MAX_CACHE_BYTES + 1)
+        if len(raw.encode('utf-8')) <= MAX_CACHE_BYTES:
+            cache = json.loads(raw)
+            if cache.get('schema') == 1:
+                entry = cache.get('channels', {}).get(cid, {})
+        if not isinstance(entry, dict):
+            entry = {}
+    except (OSError, TypeError, ValueError, AttributeError):
+        entry = {}
+    name = _text(entry.get('name')) or ('Kanał ' + cid if cid else 'Orange TV')
+    signature = _text(entry.get('logo_signature'), 1024)
+    category = _text(entry.get('category'))
+    return {
+        'channel_id': cid,
+        'name': name,
+        'logo': logo_base + signature if signature else fallback_icon,
+        'plot': ('Telewizja na żywo' if live else 'Archiwum kanału')
+                + (' · ' + category if category else ''),
+        'is_live': live,
+    }
diff --git a/plugin.video.orange_go/resources/lib/tata_programmes.py b/plugin.video.orange_go/resources/lib/tata_programmes.py
new file mode 100644
--- /dev/null
+++ b/plugin.video.orange_go/resources/lib/tata_programmes.py
@@ -0,0 +1,75 @@
+"""Public programme index from already fetched EPG. Import has no I/O or Kodi dependency."""
+import json
+from datetime import datetime, timezone
+import math
+import re
+import unicodedata
+from .tata_pvr import text
+
+
+def build_index(channels, epg):
+    selected = {}
+    for c in channels:
+        if not isinstance(c, dict):
+            continue
+        cid = str(c.get('channelExtId', ''))
+        features = c.get('playFeatures', {})
+        otg = features.get('otg', {}) if isinstance(features, dict) else {}
+        if (cid.isascii() and cid.isdecimal() and c.get('isSubscribed') is True
+                and isinstance(otg, dict) and otg.get('isChannelAllowed') is True):
+            selected.setdefault(cid, {'name': text(c.get('name')), 'programmes': {}})
+    for guide in epg.values():
+        for row in guide:
+            if not isinstance(row, dict):
+                continue
+            entry = selected.get(str(row.get('channelExtId', '')))
+            if entry is None or not isinstance(row.get('programs'), list):
+                continue
+            for p in row['programs']:
+                if not isinstance(p, dict):
+                    continue
+                pid, title = p.get('programExtId'), text(p.get('name'))
+                if isinstance(pid, bool) or not isinstance(pid, (str, int)) or not str(pid) or len(str(pid)) > 256:
+                    continue
+                try:
+                    if isinstance(p['startTimeUtc'], bool) or isinstance(p['endTimeUtc'], bool):
+                        continue
+                    start, end = float(p['startTimeUtc']), float(p['endTimeUtc'])
+                    if not title or not math.isfinite(start) or not math.isfinite(end) or end <= start:
+                        continue
+                    datetime.fromtimestamp(start, timezone.utc)
+                    datetime.fromtimestamp(end, timezone.utc)
+                except (KeyError, ValueError, TypeError, OverflowError, OSError):
+                    continue
+                entry['programmes'][(str(pid), start, end)] = {
+                    'id': str(pid), 'title': title, 'start': start, 'end': end}
+    for entry in selected.values():
+        entry['programmes'] = sorted(entry['programmes'].values(), key=lambda p: (p['start'], p['id']))
+    return json.dumps({'schema': 1, 'channels': selected}, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
+
+
+def normal(value):
+    return ' '.join(unicodedata.normalize('NFKC', value).split()) if isinstance(value, str) else ''
+
+
+def channel_id(metadata, name):
+    channels = metadata.get('channels', {})
+    for strip_hd in (False, True):
+        def key(value):
+            value = normal(value).casefold()
+            return re.sub(r'\s+hd$', '', value) if strip_hd else value
+        hits = [cid for cid, row in channels.items() if isinstance(row, dict) and key(row.get('name')) == key(name)]
+        if len(hits) == 1:
+            return hits[0]
+        if len(hits) > 1:
+            return None
+    return None
+
+
+def now_next(index, cid, now):
+    rows = index.get('channels', {}).get(cid, {}).get('programmes', [])
+    current = [p for p in rows if p['start'] <= now < p['end']]
+    if len(current) != 1:
+        return None
+    following = [p for p in rows if p['start'] >= current[0]['end']]
+    return {'now': current[0], 'next': min(following, key=lambda p: p['start']) if following else None}
diff --git a/plugin.video.orange_go/resources/lib/tata_pvr.py b/plugin.video.orange_go/resources/lib/tata_pvr.py
new file mode 100644
--- /dev/null
+++ b/plugin.video.orange_go/resources/lib/tata_pvr.py
@@ -0,0 +1,168 @@
+"""Local M3U/XMLTV export. No Kodi, HTTP, credentials or DRM implementation."""
+
+from datetime import datetime, timezone
+import os
+import tempfile
+from urllib.parse import quote, urlencode
+from xml.etree import ElementTree as ET
+
+# Stable first eight numbers and resolver URLs preserve existing PVR favourites.
+CHANNEL_IDS = ('14135', '14999', '14171', '14137', '14190', '14014', '14233', '15049')
+
+
+class ExportError(ValueError):
+    pass
+
+
+def text(value, limit=2048):
+    if not isinstance(value, str):
+        return ''
+    # XML 1.0 control characters and M3U line breaks must not become markup.
+    return ''.join(c if ord(c) >= 32 and not 0xD800 <= ord(c) <= 0xDFFF
+                   and ord(c) not in (0xFFFE, 0xFFFF) else ' ' for c in value).strip()[:limit]
+
+
+def render(channels, epg, logo_base):
+    """Export the entitled live catalogue, with favourites first and native news grouping."""
+    if not isinstance(channels, list) or not isinstance(epg, dict) or not epg:
+        raise ExportError('invalid_snapshot')
+    selected = {}
+    for channel in channels:
+        if not isinstance(channel, dict):
+            continue
+        cid = str(channel.get('channelExtId', ''))
+        if not cid.isascii() or not cid.isdecimal() or channel.get('isSubscribed') is not True:
+            continue
+        features = channel.get('playFeatures', {})
+        otg = features.get('otg', {}) if isinstance(features, dict) else {}
+        if not isinstance(otg, dict) or otg.get('isChannelAllowed') is not True:
+            continue
+        name, signature = text(channel.get('name')), text(channel.get('logoSignature'), 1024)
+        if not name or not signature:
+            raise ExportError('invalid_channel_metadata')
+        groups = []
+        if cid in CHANNEL_IDS:
+            groups.append('Ulubione taty')
+        if channel.get('category') == 'Informacje':
+            groups.append('Informacyjne')
+        # No artificial category for the rest: Kodi's native All includes every row.
+        selected.setdefault(cid, (name, logo_base + quote(signature, safe=''), ';'.join(groups)))
+    if not selected:
+        raise ExportError('empty_channels')
+
+    programmes = {cid: {} for cid in selected}
+    for guide in epg.values():
+        if not isinstance(guide, list):
+            raise ExportError('invalid_epg_snapshot')
+        for row in guide:
+            if not isinstance(row, dict):
+                continue
+            cid = str(row.get('channelExtId', ''))
+            if cid not in selected:
+                continue
+            if not isinstance(row.get('programs'), list):
+                continue
+            for programme in row['programs']:
+                if not isinstance(programme, dict):
+                    continue
+                try:
+                    start_value, stop_value = programme['startTimeUtc'], programme['endTimeUtc']
+                    if isinstance(start_value, bool) or isinstance(stop_value, bool):
+                        continue
+                    start = datetime.fromtimestamp(float(start_value), timezone.utc)
+                    stop = datetime.fromtimestamp(float(stop_value), timezone.utc)
+                    title = text(programme.get('name'))
+                    if not title or stop <= start:
+                        continue
+                except (KeyError, TypeError, ValueError, OverflowError, OSError):
+                    continue
+                key = (start, stop, title)
+                programmes[cid][key] = text(programme.get('description'), 16384)
+    if not any(programmes.values()):
+        raise ExportError('empty_epg')
+
+    m3u = ['#EXTM3U']
+    tv = ET.Element('tv', {'generator-info-name': 'Orange Go Tata local'})
+    order = [cid for cid in CHANNEL_IDS if cid in selected]
+    order.extend(cid for cid in selected if cid not in CHANNEL_IDS)
+    extra_number = len(CHANNEL_IDS)
+    for cid in order:
+        if cid in CHANNEL_IDS:
+            number = CHANNEL_IDS.index(cid) + 1
+        else:
+            extra_number += 1
+            number = extra_number
+        name, logo, groups = selected[cid]
+        m3u.append('#EXTINF:-1 tvg-id="%s" tvg-chno="%s" tvg-logo="%s" group-title="%s",%s'
+                   % (cid, number, logo, groups, name))
+        m3u.append('plugin://plugin.video.orange_go/?' + urlencode({'mode': 'playSource', 'cid': cid, 'tata_pvr': '1'}))
+        channel = ET.SubElement(tv, 'channel', {'id': cid})
+        ET.SubElement(channel, 'display-name', {'lang': 'pl'}).text = name
+        ET.SubElement(channel, 'icon', {'src': logo})
+    for cid in order:
+        for (start, stop, title), description in sorted(programmes.get(cid, {}).items()):
+            programme = ET.SubElement(tv, 'programme', {
+                'channel': cid, 'start': start.strftime('%Y%m%d%H%M%S +0000'),
+                'stop': stop.strftime('%Y%m%d%H%M%S +0000')})
+            ET.SubElement(programme, 'title', {'lang': 'pl'}).text = title
+            if description:
+                ET.SubElement(programme, 'desc', {'lang': 'pl'}).text = description
+    return ('\n'.join(m3u) + '\n').encode('utf-8'), ET.tostring(tv, encoding='utf-8', xml_declaration=True)
+
+
+def _stage(directory, data):
+    fd, path = tempfile.mkstemp(prefix='.tata-pvr-', suffix='.tmp', dir=directory)
+    try:
+        with os.fdopen(fd, 'wb') as handle:
+            handle.write(data)
+            handle.flush()
+            os.fsync(handle.fileno())
+        return path
+    except Exception:
+        os.unlink(path)
+        raise
+
+
+def publish(directory, m3u, xml, index=None):
+    """Stage complete files, atomically replace each; roll back ordinary write failures."""
+    files = {'epg.xml': xml, 'channels.m3u': m3u}
+    if index is not None:
+        files['programme-index.json'] = index
+    staged, previous, replaced = {}, {}, []
+    os.makedirs(directory, exist_ok=True)
+    try:
+        for name, data in files.items():
+            path = os.path.join(directory, name)
+            try:
+                with open(path, 'rb') as handle:
+                    previous[name] = handle.read()
+            except FileNotFoundError:
+                previous[name] = None
+            staged[name] = _stage(directory, data)
+        for name in files:
+            os.replace(staged[name], os.path.join(directory, name))
+            replaced.append(name)
+    except OSError:
+        rollback_failed = False
